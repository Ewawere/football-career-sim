{
  "name": "football-career-sim",
  "version": "0.1.0",
  "description": "Original deep football career simulator \u2013 mobile-first, simulation-first",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "sim": "tsx src/cli/run-simulation.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "test:long": "tsx src/tests/long-sim.ts",
    "lint": "echo 'No linter configured yet'",
    "test:simulation": "tsx src/tests/simulation-validation.ts",
    "demo:season": "tsx src/cli/demo-season.ts",
    "demo:career": "tsx src/cli/demo-career.ts",
    "demo:multi": "tsx src/cli/demo-multi-season.ts",
    "test:transfer-window": "tsx src/cli/demo-transfers.ts",
    "demo:transfers": "tsx src/cli/demo-transfers.ts",
    "play": "tsx src/ui/cli-app.ts",
    "demo:news": "tsx src/cli/demo-news.ts",
    "export:match": "tsx src/cli/export-match-ui.ts",
    "test:massive": "tsx src/tests/massive-sim.ts",
    "test:massive:long": "tsx src/tests/massive-sim.ts --seasons=12",
    "play:web": "tsx src/ui/server.ts",
    "start": "tsx src/ui/server.ts"
  },
  "keywords": [
    "football",
    "soccer",
    "career",
    "simulation",
    "manager"
  ],
  "author": "Football Career Sim Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
